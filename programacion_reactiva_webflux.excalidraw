    },
    {
      "id": "AqE62f3ppxI0nqGUdh6yx",
      "type": "text",
      "x": 1619.4061139596595,
      "y": 657.8585199638253,
      "width": 333.80161812083554,
      "height": 17.380442167939737,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 1068871523,
      "version": 87,
      "versionNonce": 1479203907,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034049382,
      "link": null,
      "locked": false,
      "text": "block() → detiene el flujo esperando el resultado.",
      "fontSize": 13.904353734351789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "block() → detiene el flujo esperando el resultado.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lOOp7UbGz50_AJwXuFfi6",
      "type": "text",
      "x": 1524.585469566195,
      "y": 706.5237580340566,
      "width": 523.4429069077646,
      "height": 17.380442167939737,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 55159885,
      "version": 87,
      "versionNonce": 531389411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034049382,
      "link": null,
      "locked": false,
      "text": "blockFirst(), blockLast() → bloquean hasta recibir el primer o último elemento.",
      "fontSize": 13.904353734351789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "blockFirst(), blockLast() → bloquean hasta recibir el primer o último elemento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AOEcZrONpRUMiJUg1VsGk",
      "type": "text",
      "x": 1534.7286718530813,
      "y": 746.498775020318,
      "width": 503.15650233399185,
      "height": 34.760884335879474,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0L",
      "roundness": null,
      "seed": 1890568963,
      "version": 87,
      "versionNonce": 1713170307,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034049382,
      "link": null,
      "locked": false,
      "text": "toIterable(), toStream() → convierten el flujo a estructuras que requieren\nconsumo sincrónico.",
      "fontSize": 13.904353734351789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "toIterable(), toStream() → convierten el flujo a estructuras que requieren consumo sincrónico.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Mr4MXA72Tq8_T9saquVd5",
      "type": "text",
      "x": 1534.3393304294682,
      "y": 821.2346763424588,
      "width": 503.93518518121806,
      "height": 17.380442167939737,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 189307565,
      "version": 87,
      "versionNonce": 297467683,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034049382,
      "link": null,
      "locked": false,
      "text": "Llamadas a librerías o drivers no reactivos (por ejemplo, JDBC tradicional).",
      "fontSize": 13.904353734351789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Llamadas a librerías o drivers no reactivos (por ejemplo, JDBC tradicional).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ETlmTVUfFPsItoUoxGr6E",
      "type": "text",
      "x": 1560.7228501269446,
      "y": 869.8999144126902,
      "width": 451.168145786265,
      "height": 17.380442167939737,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 522547875,
      "version": 87,
      "versionNonce": 1022698179,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034049382,
      "link": null,
      "locked": false,
      "text": "Cualquier operación I/O sin soporte asíncrono (archivos, red, etc.).",
      "fontSize": 13.904353734351789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cualquier operación I/O sin soporte asíncrono (archivos, red, etc.).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dLfit0Qij8QS8X0ai0fPI",
      "type": "text",
      "x": 1680.9047039079953,
      "y": 918.5651524829215,
      "width": 210.8044382241636,
      "height": 17.380442167939737,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
