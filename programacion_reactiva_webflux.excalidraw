      "version": 148,
      "versionNonce": 1708125315,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033324750,
      "link": null,
      "locked": false,
      "text": "Los hilos no esperan respuestas, reaccionan cuando los datos llegan.",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los hilos no esperan respuestas, reaccionan cuando los datos llegan.",
