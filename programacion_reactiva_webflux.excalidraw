      "text": "Map vs FlatMap",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Map vs FlatMap",
      "autoResize": true,
