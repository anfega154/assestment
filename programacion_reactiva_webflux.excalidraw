    },
    {
      "id": "hkBmM4PI4RGXeH2GClSBL",
      "type": "text",
      "x": 165.2207550869059,
      "y": 1193.2706869234648,
      "width": 372.5913286050672,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 314587811,
      "version": 40,
      "versionNonce": 2043909859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "map() → transforma el valor dentro del mismo flujo.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "map() → transforma el valor dentro del mismo flujo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_6wXkJw_REIaV29uRDIXs",
      "type": "text",
      "x": 179.4732361927127,
      "y": 1245.4502026032148,
      "width": 344.0863663934536,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 611349773,
      "version": 40,
      "versionNonce": 228901507,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Operación sincrónica, no cambia el tipo del flujo.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operación sincrónica, no cambia el tipo del flujo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mOUyE1Ml_BuXINZxlUV6x",
      "type": "text",
      "x": 113.27230692534309,
      "y": 1297.6297182829649,
      "width": 476.4882249281929,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1892085315,
      "version": 40,
      "versionNonce": 1368357411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Ejemplo: Mono.just(5).map(n -> n * 2) → devuelve Mono<Integer>.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ejemplo: Mono.just(5).map(n -> n * 2) → devuelve Mono<Integer>.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6mkMiV2bsRe_rbWrbznZ3",
      "type": "text",
      "x": 158.21378472822903,
      "y": 1349.8092339627149,
      "width": 386.60526932242107,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 370690925,
      "version": 40,
      "versionNonce": 578960835,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Ideal cuando la función no retorna otro Mono o Flux.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ideal cuando la función no retorna otro Mono o Flux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "isZmHIzsvu_9-qxR0kHK8",
      "type": "text",
      "x": 77.55175957035794,
      "y": 1392.670978985367,
      "width": 547.9293196381632,
      "height": 37.27108262839289,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 787885539,
      "version": 40,
      "versionNonce": 1000050019,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "flatMap() → ejecuta una función que devuelve otro flujo (Mono o Flux) y lo\naplana.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "flatMap() → ejecuta una función que devuelve otro flujo (Mono o Flux) y lo aplana.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ztUTE6tqX6AjhaiwjhfmE",
      "type": "text",
      "x": 184.50483234754574,
      "y": 1472.8038066364115,
      "width": 334.0231740837875,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 87446989,
      "version": 40,
      "versionNonce": 1881794819,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Operación asíncrona, encadena múltiples flujos.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operación asíncrona, encadena múltiples flujos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BOOMuAG3SOF8w01GWxQZO",
      "type": "text",
      "x": 95.13625362461809,
      "y": 1524.9833223161615,
      "width": 512.7603315296429,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 1348237699,
      "version": 40,
      "versionNonce": 632017059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Ejemplo: Mono.just(id).flatMap(this::findUser) → devuelve Mono<User>.",
      "fontSize": 14.908433051357157,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ejemplo: Mono.just(id).flatMap(this::findUser) → devuelve Mono<User>.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nfMpWrfBIHvizqRAMZNby",
      "type": "text",
      "x": 151.96721588534677,
      "y": 1577.1628379959116,
      "width": 399.0984070081856,
      "height": 18.635541314196445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 1290015789,
      "version": 40,
      "versionNonce": 231720003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760034753291,
      "link": null,
      "locked": false,
      "text": "Ideal para llamadas reactivas anidadas o dependientes.",
      "fontSize": 14.908433051357155,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ideal para llamadas reactivas anidadas o dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0VxXoby-5StnVv8GAwYTk",
      "type": "rectangle",
