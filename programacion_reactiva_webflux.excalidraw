      "version": 81,
      "versionNonce": 466445741,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Se usa Schedulers para ejecutar tareas en distintos contextos:",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se usa Schedulers para ejecutar tareas en distintos contextos:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XbN2NdM3ERXvqEebnNCoY",
      "type": "text",
      "x": 121.07678869981069,
      "y": 741.4813012215099,
      "width": 412.8825907169806,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 862284195,
      "version": 81,
      "versionNonce": 1104029709,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Schedulers.parallel() → tareas de CPU intensiva (cálculos).",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schedulers.parallel() → tareas de CPU intensiva (cálculos).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "inTqPDIY9HrmIBzQlLnCu",
      "type": "text",
      "x": 55.36375456425429,
      "y": 792.5121012434396,
      "width": 544.3086589880934,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 792311309,
      "version": 81,
      "versionNonce": 1128767085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Schedulers.boundedElastic() → tareas bloqueantes (I/O, llamadas externas).",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schedulers.boundedElastic() → tareas bloqueantes (I/O, llamadas externas).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JOgWYQ2RwnGlms3o6-BcM",
      "type": "text",
      "x": 125.93198523823924,
      "y": 843.5429012653693,
      "width": 403.17219764012356,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 1122909507,
      "version": 81,
      "versionNonce": 386091213,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Schedulers.immediate() → ejecuta en el mismo hilo actual.",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schedulers.immediate() → ejecuta en el mismo hilo actual.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4_mme5IRCHscHh_PKQ7dC",
      "type": "text",
      "x": 42.97056027321423,
      "y": 894.5737012872991,
      "width": 569.0950475701735,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1477536877,
      "version": 81,
      "versionNonce": 513451821,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Operadores como .publishOn() y .subscribeOn() cambian el scheduler de ejecución.",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operadores como .publishOn() y .subscribeOn() cambian el scheduler de ejecución.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RUP4HZeySz4qAmqQL-zgy",
      "type": "text",
      "x": 53.162125810518035,
      "y": 945.6045013092288,
      "width": 548.711916495566,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 2103155939,
      "version": 81,
      "versionNonce": 1282881933,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "Permite manejar miles de peticiones concurrentes con pocos hilos, sin bloqueo.",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Permite manejar miles de peticiones concurrentes con pocos hilos, sin bloqueo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8NT31kfx-wbXUSmzqJ6Ep",
      "type": "text",
      "x": 39.35464756762855,
      "y": 996.6353013311585,
      "width": 576.3268729813449,
      "height": 18.225285722117746,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1298355917,
      "version": 81,
      "versionNonce": 164790253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760033305537,
      "link": null,
      "locked": false,
      "text": "El objetivo es reutilizar hilos y no esperar resultados, optimizando el rendimiento.",
      "fontSize": 14.580228577694196,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El objetivo es reutilizar hilos y no esperar resultados, optimizando el rendimiento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
